# Local SQLite database (created by Prisma)
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=5000

# Generate 32 random bytes as 64 hex characters for AES-256-GCM chat encryption.
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CHAT_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Razorpay Route credentials. Route must be enabled for your merchant account.
# Use TEST keys for classroom testing. Never commit real keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
